# NOTEDEBOOKPRO — canonicalização de URL (Apache)
#
# Objetivo: uma única URL por página.
#   https://www.notedebookpro.com.br/servicos   (sem .html)
#   https://www.notedebookpro.com.br/blog/      (índice do blog)
#   https://www.notedebookpro.com.br/assistencia-tecnica-notebook-dell/
#
# Regras: força HTTPS, força www, remove .html (301) e serve o arquivo .html
# internamente. Sem esta configuração o site continua funcionando: o Apache
# desta hospedagem já resolve /servicos a partir de servicos.html.

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 2. Domínio canônico: www
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 3. /index.html e /pasta/index.html -> / e /pasta/
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 4. /pagina.html -> /pagina (a página de erro permanece em /404.html)
  RewriteCond %{REQUEST_URI} !^/404\.html$ [NC]
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 5. Barra final em URL que não é diretório: /servicos/ -> /servicos
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+?)/$ /$1 [R=301,L]

  # 6. URL sem extensão -> arquivo .html (interno, sem alterar a barra de endereço)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

ErrorDocument 404 /404.html
